<div class="mb-6 flex items-end justify-between gap-4">
  <div>
    <h1 class="serif text-3xl font-bold text-stone-800 mb-1">Products</h1>
    <p class="text-stone-500 text-sm">Manage store inventory.</p>
  </div>
  <button onclick="openNewProductModal()"
      class="text-white text-sm font-semibold px-4 py-2 rounded transition-colors"
      style="background-color: #537326;">+ New Product</button>
</div>

<div class="mb-4">
  <input type="text" placeholder="Search products..." autofocus oninput="filterProducts(this.value)"
    class="w-full px-4 py-2 border border-stone-300 rounded shadow-sm bg-white text-stone-800 placeholder-stone-400 focus:outline-none text-sm">
</div>

<div class="bg-white rounded-md shadow-sm border border-stone-200 overflow-hidden">
  <table class="min-w-full divide-y divide-stone-200">
    <thead>
      <tr style="background-color: #537326;">
        <th class="px-4 py-3 text-left text-xs font-semibold text-stone-300 uppercase tracking-widest">Section</th>
        <th class="px-4 py-3 text-left text-xs font-semibold text-stone-300 uppercase tracking-widest">Name</th>
        <th class="px-4 py-3 text-left text-xs font-semibold text-stone-300 uppercase tracking-widest">Price</th>
        <th class="px-4 py-3 text-left text-xs font-semibold text-stone-300 uppercase tracking-widest">Qty</th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-stone-100">
      <% if @products.empty? %>
        <tr><td colspan="5" class="px-4 py-8 text-center text-stone-400 text-sm italic">No products yet.</td></tr>
      <% else %>
        <% @products.each do |product, purchase_count| %>
          <tr data-name="<%= product.name.downcase %>" data-section="<%= product.section.downcase %>" class="hover:bg-amber-50 transition-colors">
            <td class="px-4 py-3 text-stone-500 text-xs font-semibold uppercase tracking-wide"><%= product.section %></td>
            <td class="px-4 py-3">
              <span class="font-medium text-stone-800"><%= product.name %></span>
              <% if purchase_count > 0 %>
                <button onclick="showPurchaseHistory(<%= product.id %>)"
                  class="text-xs text-green-700 hover:underline mt-0.5 block">
                  Purchased <%= purchase_count %> time<%= purchase_count == 1 ? "" : "s" %>
                </button>
              <% end %>
            </td>
            <td class="px-4 py-3 text-stone-700">$<%= number_with_precision(product.price, precision: 2) %></td>
            <td class="px-4 py-3 <%= product.quantity == 0 ? "text-red-500 font-semibold" : "text-stone-700" %>"><%= product.quantity %></td>
            <td class="px-4 py-3 text-right">
              <div class="flex items-center justify-end gap-2">
                <%= link_to "Edit", edit_product_path(product),
                    class: "text-xs font-semibold px-3 py-1 rounded border border-stone-300 text-stone-600 hover:bg-stone-100 transition-colors" %>
                <%= button_to "Delete", product_path(product), method: :delete,
                    class: "text-xs font-semibold px-3 py-1 rounded border border-red-200 text-red-500 hover:bg-red-50 transition-colors",
                    form: { data: { turbo_confirm: "Delete \"#{product.name}\"?#{purchase_count > 0 ? " This will also delete #{purchase_count} purchase record#{purchase_count == 1 ? "" : "s"}." : ""}" } } %>
              </div>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>

<%# New Product Modal %>
<div id="new-product-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40">
  <div class="bg-white rounded-lg shadow-xl w-full max-w-sm mx-4 overflow-hidden">
    <div class="px-6 py-4 border-b border-stone-200" style="background-color: #537326;">
      <h2 class="serif text-lg font-semibold text-white">New Product</h2>
    </div>
    <div class="px-6 py-5 space-y-4">
      <div id="new-product-error" class="hidden bg-red-50 border border-red-200 text-red-800 px-3 py-2 rounded text-sm"></div>
      <div>
        <label class="block text-xs font-semibold uppercase tracking-widest text-stone-500 mb-1">Product Name</label>
        <input id="np-name" type="text" placeholder="e.g. Candy Bar"
          class="w-full px-3 py-2 border border-stone-300 rounded text-stone-800 text-sm focus:outline-none focus:ring-2 focus:ring-green-700">
      </div>
      <div>
        <label class="block text-xs font-semibold uppercase tracking-widest text-stone-500 mb-1">Price ($)</label>
        <input id="np-price" type="number" step="0.01" min="0.01" placeholder="0.00"
          class="w-full px-3 py-2 border border-stone-300 rounded text-stone-800 text-sm focus:outline-none focus:ring-2 focus:ring-green-700">
      </div>
      <div>
        <label class="block text-xs font-semibold uppercase tracking-widest text-stone-500 mb-1">Quantity</label>
        <input id="np-quantity" type="number" step="1" min="0" value="999"
          class="w-full px-3 py-2 border border-stone-300 rounded text-stone-800 text-sm focus:outline-none focus:ring-2 focus:ring-green-700">
      </div>
      <div>
        <label class="block text-xs font-semibold uppercase tracking-widest text-stone-500 mb-1">Section</label>
        <input id="np-section" type="text" placeholder="e.g. Snacks"
          class="w-full px-3 py-2 border border-stone-300 rounded text-stone-800 text-sm focus:outline-none focus:ring-2 focus:ring-green-700">
      </div>
    </div>
    <div class="px-6 py-4 border-t border-stone-100 flex justify-end gap-3">
      <button onclick="closeNewProductModal()" class="px-4 py-2 text-sm text-stone-600 hover:text-stone-800 transition-colors">Cancel</button>
      <button id="np-submit" onclick="submitNewProduct()"
        class="px-4 py-2 text-sm text-white font-semibold rounded transition-colors"
        style="background-color: #537326;">Add Product</button>
    </div>
  </div>
</div>

<%# Purchase History Modal %>
<div id="purchase-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40">
  <div class="bg-white rounded-lg shadow-xl w-full max-w-lg mx-4 overflow-hidden max-h-[80vh] flex flex-col">
    <div class="px-6 py-4 border-b border-stone-200 flex items-center justify-between" style="background-color: #537326;">
      <h2 id="modal-title" class="serif text-lg font-semibold text-white">Purchase History</h2>
      <button onclick="closePurchaseModal()" class="text-white/70 hover:text-white text-2xl font-bold leading-none">&times;</button>
    </div>
    <div id="modal-body" class="overflow-y-auto flex-1 px-6 py-4"></div>
  </div>
</div>

<script>
  function openNewProductModal() {
    document.getElementById("new-product-modal").classList.remove("hidden")
    document.getElementById("np-name").focus()
  }

  function closeNewProductModal() {
    document.getElementById("new-product-modal").classList.add("hidden")
    document.getElementById("new-product-error").classList.add("hidden")
    ;["np-name", "np-price", "np-section"].forEach(id => document.getElementById(id).value = "")
    document.getElementById("np-quantity").value = "999"
  }

  async function submitNewProduct() {
    const name = document.getElementById("np-name").value.trim()
    const price = document.getElementById("np-price").value.trim()
    const quantity = document.getElementById("np-quantity").value.trim()
    const section = document.getElementById("np-section").value.trim()
    const errorEl = document.getElementById("new-product-error")

    errorEl.classList.add("hidden")
    const btn = document.getElementById("np-submit")
    btn.textContent = "Saving..."
    btn.disabled = true

    try {
      const resp = await fetch("/products", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Accept": "application/json",
          "X-CSRF-Token": document.querySelector("meta[name='csrf-token']").content
        },
        body: JSON.stringify({ product: { name, price, quantity, section } })
      })
      const data = await resp.json()
      if (!resp.ok) {
        errorEl.textContent = data.error || "Failed to add product"
        errorEl.classList.remove("hidden")
        btn.textContent = "Add Product"
        btn.disabled = false
        return
      }
      window.location.reload()
    } catch {
      errorEl.textContent = "Something went wrong"
      errorEl.classList.remove("hidden")
      btn.textContent = "Add Product"
      btn.disabled = false
    }
  }

  document.getElementById("new-product-modal").addEventListener("click", function(e) {
    if (e.target === this) closeNewProductModal()
  })

  document.addEventListener("keydown", function(e) {
    if (e.key === "Escape") closeNewProductModal()
  })

  function filterProducts(q) {
    q = q.toLowerCase()
    document.querySelectorAll("tr[data-name]").forEach(row => {
      const match = row.dataset.name.includes(q) || row.dataset.section.includes(q)
      row.classList.toggle("hidden", !match)
    })
  }

  async function showPurchaseHistory(productId) {
    const modal = document.getElementById("purchase-modal")
    const body = document.getElementById("modal-body")
    body.innerHTML = '<p class="text-stone-400 text-sm italic">Loading...</p>'
    modal.classList.remove("hidden")

    try {
      const resp = await fetch(`/api/products/${productId}/purchases`, { headers: { Accept: "application/json" } })
      const data = await resp.json()
      document.getElementById("modal-title").textContent = data.product_name

      if (!data.purchases.length) {
        body.innerHTML = '<p class="text-stone-400 text-sm italic">No purchases found.</p>'
        return
      }

      const total = data.purchases.reduce((s, p) => s + p.price_at_purchase * p.quantity, 0)
      body.innerHTML = `
        <ul class="divide-y divide-stone-100 -mx-6">
          ${data.purchases.map(p => `
            <li class="px-6 py-3 flex items-center justify-between gap-4">
              <div>
                <a href="/campers/${p.camper_id}" class="font-medium text-green-700 hover:underline text-sm">${p.camper_name}</a>
                <p class="text-xs text-stone-400">${p.created_at}</p>
              </div>
              <div class="text-right flex-shrink-0">
                <p class="text-sm font-semibold text-stone-700">$${(p.price_at_purchase * p.quantity).toFixed(2)}</p>
                <p class="text-xs text-stone-400">&times; ${p.quantity} @ $${p.price_at_purchase.toFixed(2)}</p>
              </div>
            </li>`).join("")}
        </ul>
        <div class="mt-4 pt-3 border-t border-stone-200 flex justify-between text-sm font-semibold text-stone-700">
          <span>${data.purchases.length} purchase${data.purchases.length === 1 ? "" : "s"}</span>
          <span>$${total.toFixed(2)} total</span>
        </div>`
    } catch {
      body.innerHTML = '<p class="text-red-400 text-sm italic">Failed to load purchase history.</p>'
    }
  }

  function closePurchaseModal() {
    document.getElementById("purchase-modal").classList.add("hidden")
  }

  document.getElementById("purchase-modal").addEventListener("click", function(e) {
    if (e.target === this) closePurchaseModal()
  })
</script>

<div class="mb-6">
  <%= link_to "&larr; All Products".html_safe, products_path, class: "text-stone-500 hover:text-green-800 text-sm mb-2 inline-block transition-colors" %>
  <h1 class="serif text-3xl font-bold text-stone-800">Edit Product</h1>
</div>

<div class="bg-white rounded-md shadow-sm border border-stone-200 max-w-md">
  <%= form_with model: @product, url: product_path(@product), method: :patch do |f| %>
    <div class="px-6 py-5 space-y-4">
      <% if @product.errors.any? %>
        <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded text-sm">
          <%= @product.errors.full_messages.join(", ") %>
        </div>
      <% end %>
      <div>
        <%= f.label :name, "Product Name", class: "block text-xs font-semibold uppercase tracking-widest text-stone-500 mb-1" %>
        <%= f.text_field :name, autofocus: true,
            class: "w-full px-3 py-2 border border-stone-300 rounded text-stone-800 text-sm focus:outline-none focus:ring-2 focus:ring-green-700" %>
      </div>
      <div>
        <%= f.label :price, "Price ($)", class: "block text-xs font-semibold uppercase tracking-widest text-stone-500 mb-1" %>
        <%= f.number_field :price, step: 0.01, min: 0.01,
            class: "w-full px-3 py-2 border border-stone-300 rounded text-stone-800 text-sm focus:outline-none focus:ring-2 focus:ring-green-700" %>
      </div>
      <div>
        <%= f.label :quantity, "Quantity", class: "block text-xs font-semibold uppercase tracking-widest text-stone-500 mb-1" %>
        <%= f.number_field :quantity, min: 0, step: 1,
            class: "w-full px-3 py-2 border border-stone-300 rounded text-stone-800 text-sm focus:outline-none focus:ring-2 focus:ring-green-700" %>
      </div>
      <div>
        <%= f.label :section, "Section", class: "block text-xs font-semibold uppercase tracking-widest text-stone-500 mb-1" %>
        <%= f.text_field :section,
            class: "w-full px-3 py-2 border border-stone-300 rounded text-stone-800 text-sm focus:outline-none focus:ring-2 focus:ring-green-700" %>
      </div>
    </div>
    <div class="px-6 py-4 border-t border-stone-100 flex justify-end gap-3">
      <%= link_to "Cancel", products_path, class: "px-4 py-2 text-sm text-stone-600 hover:text-stone-800 transition-colors" %>
      <%= f.submit "Save Changes",
          class: "px-4 py-2 text-sm text-white font-semibold rounded transition-colors cursor-pointer",
          style: "background-color: #537326;" %>
    </div>
  <% end %>
</div>

<div class="mb-6 flex items-end justify-between gap-4">
  <div>
    <h1 class="serif text-3xl font-bold text-stone-800 mb-1">Campers</h1>
    <p class="text-stone-500 text-sm">Select a camper to view their balance and make purchases.</p>
  </div>
</div>

<div data-controller="search">
  <div class="mb-4">
    <input
      data-search-target="input"
      data-action="input->search#filter"
      type="text"
      placeholder="Search campers..."
      class="w-full px-4 py-2 border border-stone-300 rounded shadow-sm bg-white text-stone-800 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-stone-400 text-sm"
    >
  </div>

  <div class="bg-white rounded shadow-sm border border-stone-200 overflow-hidden">
    <table class="min-w-full divide-y divide-stone-200">
      <thead>
        <tr style="background-color: #537326;">
          <th class="px-6 py-3 text-left text-xs font-semibold text-stone-300 uppercase tracking-widest">Camper</th>
          <th class="px-6 py-3 text-right text-xs font-semibold text-stone-300 uppercase tracking-widest">Remaining Balance</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-stone-100">
        <% @campers.each do |camper| %>
          <tr
            data-search-target="row"
            data-name="<%= camper.name %>"
            onclick="window.location='<%= camper_path(camper) %>'"
            class="hover:bg-amber-50 transition-colors cursor-pointer"
          >
            <td class="px-6 py-4 font-semibold text-stone-700"><%= camper.name %></td>
            <td class="px-6 py-4 text-right">
              <span class="font-semibold <%= camper.balance < 20 ? 'text-red-600' : 'text-green-800' %>">
                $<%= sprintf('%.2f', camper.balance) %>
              </span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

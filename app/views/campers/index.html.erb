<div class="no-print">
  <div class="mb-6 flex items-end justify-between">
    <div>
      <h1 class="serif text-3xl font-bold text-stone-800 mb-1">Campers</h1>
      <p class="text-stone-500 text-sm">Select a camper to view their balance and make purchases.</p>
    </div>
    <button onclick="window.print()"
            class="text-sm font-semibold px-4 py-2 rounded shadow-sm border border-stone-300 text-stone-600 hover:bg-stone-50 transition-colors">
      Print Balances
    </button>
  </div>

  <div class="mb-4">
    <input type="text" placeholder="Search campers..." autofocus
      oninput="filterCampers(this.value)"
      class="w-full px-4 py-2 border border-stone-300 rounded shadow-sm bg-white text-stone-800 placeholder-stone-400 focus:outline-none text-sm">
  </div>

  <div class="bg-white rounded-md shadow-sm border border-stone-200 overflow-hidden">
    <table class="min-w-full divide-y divide-stone-200">
      <thead>
        <tr style="background-color: #537326;">
          <th class="px-6 py-3 text-left text-xs font-semibold text-stone-300 uppercase tracking-widest">Camper</th>
          <th class="px-6 py-3 text-right text-xs font-semibold text-stone-300 uppercase tracking-widest">Remaining Balance</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-stone-100">
        <% @campers.each do |camper| %>
          <tr data-name="<%= camper.name.downcase %>" class="hover:bg-amber-50 transition-colors cursor-pointer"
              onclick="window.location='<%= camper_path(camper) %>'">
            <td class="px-6 py-4 font-semibold text-stone-700"><%= camper.name %></td>
            <td class="px-6 py-4 text-right font-semibold <%= camper.balance < 0 ? "text-red-600" : "text-green-800" %>">
              <%= camper.balance < 0 ? "-" : "" %>$<%= number_with_precision(camper.balance.abs, precision: 2) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <script>
    function filterCampers(q) {
      q = q.toLowerCase()
      document.querySelectorAll("tr[data-name]").forEach(row => {
        row.classList.toggle("hidden", !row.dataset.name.includes(q))
      })
    }
  </script>
</div>

<div class="print-only hidden">
  <h1 style="font-family: 'Lora', serif; font-size: 1.5rem; font-weight: 700; margin-bottom: 1rem;">Camper Balances</h1>
  <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem;">
    <thead>
      <tr style="border-bottom: 2px solid #333;">
        <th style="text-align: left; padding: 6px 12px;">Camper</th>
        <th style="text-align: right; padding: 6px 12px;">Balance</th>
      </tr>
    </thead>
    <tbody>
      <% @campers.each do |camper| %>
        <tr style="border-bottom: 1px solid #ddd;">
          <td style="padding: 5px 12px;"><%= camper.name %></td>
          <td style="text-align: right; padding: 5px 12px; <%= camper.balance < 0 ? "color: #dc2626;" : "color: #166534;" %>">
            <%= camper.balance < 0 ? "-" : "" %>$<%= number_with_precision(camper.balance.abs, precision: 2) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

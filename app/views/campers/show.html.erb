<div class="flex items-start justify-between mb-8">
  <div>
    <a href="/" class="text-stone-500 hover:text-green-800 text-sm mb-2 inline-block transition-colors">&larr; All Campers</a>
    <h1 class="serif text-3xl font-bold text-stone-800"><%= @camper.name %></h1>
  </div>
  <div class="text-right bg-white border border-stone-200 rounded shadow-sm px-6 py-4">
    <p class="text-xs uppercase tracking-widest text-stone-400 mb-1">Balance</p>
    <p class="serif text-4xl font-bold <%= @camper.balance < 0 ? 'text-red-600' : 'text-green-800' %>">
      <%= number_to_currency(@camper.balance) %>
    </p>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

  <!-- Left: Store Items (2/3) -->
  <div class="lg:col-span-2">
    <div class="bg-white rounded rounded-md shadow-sm border border-stone-200 overflow-hidden" data-controller="search">
      <div class="px-5 py-4 border-b border-stone-200 flex items-center gap-3" style="background-color: #537326;">
        <h2 class="serif text-lg font-semibold text-white flex-shrink-0">Store Items</h2>
        <input
          data-search-target="input"
          data-action="input->search#filter"
          type="text"
          autofocus
          placeholder="Search..."
          class="flex-1 px-3 py-1 text-sm rounded border-0 bg-white/20 text-white placeholder-white/60 focus:outline-none min-w-0"
        >
      </div>

      <% if @products_by_section.empty? %>
        <p class="px-5 py-6 text-stone-400 text-sm italic">No items available.</p>
      <% else %>
        <% @products_by_section.each_with_index do |(section, products), i| %>
          <div class="<%= i > 0 ? 'border-t border-stone-100' : '' %> px-5 py-4" data-search-target="section">
            <h3 class="text-xs font-semibold uppercase tracking-widest text-green-800 mb-3"><%= section %></h3>
            <div class="space-y-1">
              <% products.each do |product| %>
                <div class="flex items-center justify-between py-2 px-3 rounded hover:bg-amber-50 transition-colors cursor-pointer"
                     data-search-target="row"
                     data-name="<%= product.name %>"
                     onclick="this.querySelector('form').requestSubmit()">
                  <div>
                    <span class="font-medium text-stone-800"><%= product.name %></span>
                    <span class="text-sm text-stone-500 ml-2">$<%= sprintf('%.2f', product.price) %></span>
                    <span class="text-xs text-stone-400 ml-1">(<%= product.quantity %> left)</span>
                  </div>
                  <%= button_to "+ Add", camper_cart_items_path(@camper),
                      method: :post,
                      params: { product_id: product.id },
                      class: "text-white text-xs font-semibold px-3 py-1 rounded tracking-wide transition-colors pointer-events-none",
                      style: "background-color: #4a7c3f;" %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Right: Cart + Purchase History (1/3) -->
  <div class="lg:col-span-1 flex flex-col gap-8 sticky top-4 self-start max-h-[calc(100vh-2rem)] overflow-y-auto">

    <!-- Cart -->
    <div class="bg-white rounded-md shadow-sm border border-stone-200">
      <div class="px-5 py-4 border-b border-stone-200 rounded-t-md" style="background-color: #537326;">
        <h2 class="serif text-lg font-semibold text-white">Cart</h2>
      </div>

      <% cart = @camper.cart_or_create %>
      <% cart_items = cart.cart_items.includes(:product) %>

      <% if cart_items.empty? %>
        <p class="px-5 py-6 text-stone-400 text-sm italic">Your cart is empty.</p>
      <% else %>
        <ul class="divide-y divide-stone-100">
          <% cart_items.each do |item| %>
            <li class="px-4 py-3 flex items-center justify-between gap-2">
              <span class="font-medium text-stone-800 flex-1 text-sm"><%= item.product.name %></span>

              <div class="flex items-center gap-1">
                <%= button_to "−", camper_cart_item_path(@camper, item),
                    method: :patch,
                    params: { direction: "down" },
                    class: "w-6 h-6 flex items-center justify-center rounded border border-stone-300 text-stone-600 hover:bg-stone-100 font-bold leading-none transition-colors text-xs",
                    data: item.quantity == 1 ? { turbo_confirm: "Remove #{item.product.name} from cart?" } : {} %>
                <span class="w-5 text-center font-semibold text-stone-700 text-sm"><%= item.quantity %></span>
                <%= button_to "+", camper_cart_item_path(@camper, item),
                    method: :patch,
                    params: { direction: "up" },
                    class: "w-6 h-6 flex items-center justify-center rounded border border-stone-300 text-stone-600 hover:bg-stone-100 font-bold leading-none transition-colors text-xs" %>
              </div>

              <span class="text-stone-700 text-xs w-12 text-right">$<%= sprintf('%.2f', item.subtotal) %></span>

              <%= button_to "✕", camper_cart_item_path(@camper, item),
                  method: :delete,
                  class: "text-stone-300 hover:text-red-500 text-xs font-bold transition-colors",
                  data: { turbo_confirm: "Remove #{item.product.name} from cart?" } %>
            </li>
          <% end %>
        </ul>

        <div class="px-4 py-3 border-t border-stone-200 bg-stone-50 rounded-b-md flex items-center justify-between">
          <span class="font-semibold text-stone-700 text-sm">$<%= sprintf('%.2f', cart.total) %></span>
          <%= button_to "Checkout →", camper_purchases_path(@camper),
              method: :post,
              class: "text-white font-semibold px-4 py-1.5 rounded text-xs tracking-wide transition-colors",
              style: "background-color: #537326;",
              data: { turbo_confirm: "Complete purchase for $#{sprintf('%.2f', cart.total)}?" } %>
        </div>
      <% end %>
    </div>

    <!-- Purchase History -->
    <div class="bg-white rounded-md shadow-sm border border-stone-200">
      <div class="px-5 py-4 border-b border-stone-200 rounded-t-md" style="background-color: #537326;">
        <h2 class="serif text-lg font-semibold text-white">Purchase History</h2>
      </div>

      <% if @purchases.empty? %>
        <p class="px-5 py-6 text-stone-400 text-sm italic">No purchases yet.</p>
      <% else %>
        <ul class="divide-y divide-stone-100">
          <% @purchases.each do |purchase| %>
            <li class="px-4 py-3">
              <div class="flex items-center justify-between">
                <div>
                  <span class="font-medium text-stone-800 text-sm"><%= purchase.product.name %></span>
                  <span class="text-xs text-stone-500 ml-1">× <%= purchase.quantity %></span>
                </div>
                <span class="text-stone-700 font-semibold text-sm">$<%= sprintf('%.2f', purchase.subtotal) %></span>
              </div>
              <p class="text-xs text-stone-400 mt-0.5"><%= purchase.created_at.strftime("%b %-d at %-I:%M %p") %></p>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>

  </div>

</div>

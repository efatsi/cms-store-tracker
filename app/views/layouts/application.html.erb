<!DOCTYPE html>
<html>
  <head>
    <title>Camp Mont Shenandoah Store</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Camp Store">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:wght@400;600;700&family=Open+Sans:wght@400;500;600&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <style>
      body { font-family: 'Open Sans', sans-serif; }
      h1, h2, .serif { font-family: 'Lora', serif; }
      @media print {
        nav, footer { display: none !important; }
        body { background: white !important; }
        .no-print { display: none !important; }
        .print-only { display: block !important; }
      }
    </style>
  </head>

  <body class="min-h-screen" style="background-color: #f4ede0;">
    <nav style="background-color: #537326;" class="text-white shadow-md">
      <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-6">
          <%= link_to root_path, class: "flex items-center gap-3" do %>
            <span class="text-2xl serif font-bold tracking-wide">Camp Mont Shenandoah</span>
            <span class="text-stone-400 text-sm font-light tracking-widest uppercase">Store</span>
          <% end %>
          <div class="flex items-center gap-1">
            <%= link_to "Campers", root_path, class: "text-white/80 hover:text-white text-sm px-3 py-1 rounded hover:bg-white/10 transition-colors" %>
            <%= link_to "Staff", staff_members_path, class: "text-white/80 hover:text-white text-sm px-3 py-1 rounded hover:bg-white/10 transition-colors" %>
            <%= link_to "Products", products_path, class: "text-white/80 hover:text-white text-sm px-3 py-1 rounded hover:bg-white/10 transition-colors" %>
          </div>
        </div>
      </div>
    </nav>

    <% if flash[:notice] %>
      <div class="max-w-7xl mx-auto px-6 pt-4">
        <div class="bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded text-sm"><%= flash[:notice] %></div>
      </div>
    <% end %>
    <% if flash[:alert] %>
      <div class="max-w-7xl mx-auto px-6 pt-4">
        <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded text-sm"><%= flash[:alert] %></div>
      </div>
    <% end %>

    <main class="max-w-7xl mx-auto px-6 py-8">
      <%= yield %>
    </main>

    <footer style="background-color: #537326;" class="text-stone-400 text-center text-xs py-4 mt-16">
      &copy; <%= Date.current.year %> Camp Mont Shenandoah &mdash; Creating Unforgettable Summers Since 1927
    </footer>
  </body>
</html>
